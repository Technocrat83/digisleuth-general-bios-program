{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:digisleuth:ble:dispatch:v0.1",
  "type": "object",
  "required": ["lease_id", "opaque_trial_id", "nonce", "issued_at", "expires_at", "state", "scope_digest"],
  "additionalProperties": false,
  "properties": {
    "lease_id": {"type": "string"},
    "opaque_trial_id": {"type": "string", "pattern": "^X_[0-9]{3,}$"},
    "nonce": {"type": "string", "minLength": 16},
    "issued_at": {"type": "number"},
    "expires_at": {"type": "number"},
    "state": {"enum": ["ISSUED", "CONSUMED", "REVOKED", "EXPIRED"]},
    "scope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
