{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OAB_FIXTURE_LOADER_CONTRACT_v0.1",
  "title": "OAB Fixture Loader Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "single_fault",
    "field_delta",
    "expected_localization",
    "expected_monitor"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "enum": ["OAB1", "OAB2", "OAB3", "OAB4", "OAB5", "OAB6", "OAB7", "OAB8"]
    },
    "single_fault": {"const": true},
    "field_delta": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "object_id",
        "delta_id",
        "prior_orientation_hash",
        "prior_graph_hash",
        "current_graph_hash",
        "prior_jurisdiction_hash",
        "current_jurisdiction_hash",
        "prior_provenance_hash",
        "current_provenance_hash",
        "prior_placement_hash",
        "current_placement_hash",
        "prior_state_hash",
        "current_state_hash",
        "prior_boundary_hash",
        "current_boundary_hash",
        "prior_epoch",
        "current_epoch",
        "adjacency_changed",
        "authority_use_attempted",
        "evidence_complete"
      ]
    },
    "expected_localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standing", "affected_surfaces", "causal_cone", "jurisdictional_cone"],
      "properties": {
        "standing": {
          "type": "string",
          "enum": ["LOCALIZED", "NO_MATERIAL_INTERSECTION", "UNRESOLVED"]
        },
        "affected_surfaces": {"type": "array", "items": {"type": "string"}},
        "causal_cone": {"type": "array", "items": {"type": "string"}},
        "jurisdictional_cone": {"type": "array", "items": {"type": "string"}}
      }
    },
    "expected_monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "historical_orientation_preserved",
        "epistemic_standing_changed",
        "repair_attempted",
        "auto_reorientation",
        "authority_effect",
        "execution_effect"
      ],
      "properties": {
        "lifecycle": {
          "type": "string",
          "enum": ["CURRENT", "SUSPENDED", "WITHDRAWN"]
        },
        "historical_orientation_preserved": {"type": "boolean"},
        "epistemic_standing_changed": {"type": "boolean"},
        "repair_attempted": {"const": false},
        "auto_reorientation": {"const": false},
        "authority_effect": {"type": "string"},
        "execution_effect": {"type": "string"}
      }
    },
    "notes": {"type": "string"}
  }
}
