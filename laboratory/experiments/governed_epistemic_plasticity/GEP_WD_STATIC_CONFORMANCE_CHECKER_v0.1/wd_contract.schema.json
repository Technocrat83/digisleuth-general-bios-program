{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GEP_WD_IDENTITY_CONTRACT_v0.1",
  "title": "W_D Derivation Warrant Identity Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "warrant_id",
    "rule_id",
    "rule_version",
    "input_ids",
    "source_cone_id",
    "assumptions",
    "scope",
    "jurisdiction",
    "epoch",
    "issuer_id",
    "provenance"
  ],
  "properties": {
    "warrant_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "rule_version": {"type": "string", "minLength": 1},
    "input_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_cone_id": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "scope": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "epoch": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["artifact_id", "content_hash", "replay_ref"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "minLength": 1},
        "replay_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
