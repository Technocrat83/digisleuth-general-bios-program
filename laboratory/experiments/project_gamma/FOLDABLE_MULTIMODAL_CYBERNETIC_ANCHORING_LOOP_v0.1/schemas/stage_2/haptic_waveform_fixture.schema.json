{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:digisleuth:fmcal:haptic-waveform-fixture-core:v0.1",
  "title": "FMCAL Evaluator-Visible Haptic Waveform Fixture Core",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "schema_version", "pattern", "profile_id", "drive", "spectral", "temporal", "envelope", "physical_observation"],
  "properties": {
    "fixture_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "0.1"},
    "pattern": {"enum": ["SINGLE_PULSE", "DOUBLE_PULSE", "RISING_CHIRP", "DESCENDING_CHIRP", "FIRM_INTERRUPTION", "ZERO_PATTERN"]},
    "profile_id": {"type": "string", "minLength": 1},
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amplitude_v", "polarity", "command_envelope_update_rate_hz", "synthesized_carrier_sample_rate_hz", "driver_modulation_rate_hz"],
      "properties": {
        "amplitude_v": {"type": "number"},
        "polarity": {"enum": ["POSITIVE", "NEGATIVE", "BIPOLAR"]},
        "command_envelope_update_rate_hz": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"const": "NOT_APPLICABLE"}]},
        "synthesized_carrier_sample_rate_hz": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"const": "NOT_APPLICABLE"}]},
        "driver_modulation_rate_hz": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"const": "UNBOUND"}]}
      }
    },
    "spectral": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "NOT_APPLICABLE_TO_COMMAND_ENVELOPE_FIXTURE"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "highest_commanded_carrier_hz", "analysis_band_hz", "energy_containment_ratio", "effective_upper_frequency_hz", "out_of_band_energy_max_ratio", "derivation_method", "window_function"],
          "properties": {
            "mode": {"const": "EFFECTIVE_OCCUPIED_BANDWIDTH"},
            "carrier_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
            "sweep_start_hz": {"type": "number", "minimum": 0},
            "sweep_end_hz": {"type": "number", "exclusiveMinimum": 0},
            "highest_commanded_carrier_hz": {"type": "number", "exclusiveMinimum": 0},
            "analysis_band_hz": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "number", "minimum": 0}, "maximum": {"type": "number", "exclusiveMinimum": 0}}},
            "energy_containment_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "effective_upper_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
            "out_of_band_energy_max_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "derivation_method": {"type": "string", "minLength": 1},
            "window_function": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_duration_ms", "pulse_count", "onset_definition", "terminal_definition", "pulse_end_definition"],
      "properties": {
        "total_duration_ms": {"type": "number", "exclusiveMinimum": 0},
        "pulse_duration_ms": {"type": "number", "exclusiveMinimum": 0},
        "pulse_count": {"type": "integer", "minimum": 0},
        "inter_pulse_gap_ms": {"type": "number", "minimum": 0},
        "braking_duration_ms": {"type": "number", "minimum": 0},
        "onset_definition": {"type": "string", "minLength": 1},
        "terminal_definition": {"type": "string", "minLength": 1},
        "pulse_end_definition": {"type": "object", "additionalProperties": false, "required": ["command_end", "observed_mechanical_end"], "properties": {"command_end": {"type": "string", "minLength": 1}, "predicted_mechanical_end": {"type": ["string", "null"]}, "observed_mechanical_end": {"type": "null"}}}
      },
      "allOf": [{"if": {"properties": {"pulse_count": {"minimum": 2}}, "required": ["pulse_count"]}, "then": {"required": ["inter_pulse_gap_ms"]}}]
    },
    "envelope": {"type": "object", "additionalProperties": false, "required": ["shape", "parameters", "phase_policy", "discontinuity_policy"], "properties": {"shape": {"type": "string", "minLength": 1}, "parameters": {"type": "object"}, "phase_policy": {"type": "string", "minLength": 1}, "discontinuity_policy": {"type": "string", "minLength": 1}}},
    "physical_observation": {"type": "null"}
  },
  "not": {"required": ["expected_adjudication"]},
  "x-invariants": ["expected_answers_are_forbidden", "finite_duration_does_not_imply_finite_spectral_support", "observed_mechanical_end_is_null_before_execution"]
}
