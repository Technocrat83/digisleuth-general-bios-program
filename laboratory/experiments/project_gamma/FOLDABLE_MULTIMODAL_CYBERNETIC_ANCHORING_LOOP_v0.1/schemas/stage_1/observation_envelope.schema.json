{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:digisleuth:fmcal:observation-envelope:v0.1",
  "title": "FMCAL Observation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id", "immutability_state", "raw_measurement_hash",
    "derived_metric_lineage", "frequency_response", "temporal_response"
  ],
  "properties": {
    "envelope_id": {"type": "string", "minLength": 1},
    "immutability_state": {"const": "SEALED_AT_MEASUREMENT_START"},
    "raw_measurement_hash": {"type": "string", "pattern": "^[a-z0-9_-]+:[a-fA-F0-9]+$"},
    "derived_metric_lineage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "frequency_response": {
      "type": "object",
      "required": ["amplitude_response_db", "phase_response", "group_delay_ms", "resonance_frequency_hz", "usable_bandwidth_hz", "noise_floor", "thd"],
      "properties": {
        "amplitude_response_db": {}, "phase_response": {}, "group_delay_ms": {},
        "resonance_frequency_hz": {}, "usable_bandwidth_hz": {}, "noise_floor": {},
        "thd": {}, "intermodulation_distortion": {}
      },
      "additionalProperties": false
    },
    "temporal_response": {
      "type": "object",
      "required": ["command_latency_ms", "onset_latency_ms", "rise_time_ms", "fall_time_ms", "settling_time_ms", "overshoot", "pulse_separation_threshold_ms", "braking_response_ms"],
      "properties": {
        "command_latency_ms": {}, "onset_latency_ms": {}, "rise_time_ms": {},
        "fall_time_ms": {}, "settling_time_ms": {}, "overshoot": {},
        "pulse_separation_threshold_ms": {}, "braking_response_ms": {}
      },
      "additionalProperties": false
    }
  }
}
