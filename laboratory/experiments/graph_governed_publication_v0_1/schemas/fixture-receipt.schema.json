{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:digisleuth:publication:fixture-receipt:0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "receipt_kind": {
      "const": "FIXTURE_RESULT"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^F(0[1-9]|1[0-2])$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "specimen_id": {
      "const": "EBA_TEST_001"
    },
    "mode": {
      "enum": [
        "MOCK",
        "REAL_BOUNDARY"
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "contract_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "implementation_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "implementation_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "envelope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "contract_manifest_sha256",
        "contract_commit",
        "implementation_commit",
        "implementation_manifest_sha256",
        "registry_sha256",
        "envelope_sha256",
        "policy_sha256"
      ],
      "additionalProperties": false
    },
    "initial_conditions": {
      "type": "object"
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "op",
          "args"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "authoritative_ordering": {
      "type": "object",
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "complete": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "attempt_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "intent_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "seq",
              "tick",
              "kind",
              "actor",
              "attempt_id",
              "intent_id",
              "details"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "mechanism",
        "complete",
        "events"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "last": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "last",
        "reasons"
      ],
      "additionalProperties": false
    },
    "independent_effect_observations": {
      "type": "object",
      "properties": {
        "observer_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "independence_limit": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "publication_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "identity_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "protected_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "governing_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "draft_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "publications": {
                  "type": "array"
                },
                "identities": {
                  "type": "array"
                }
              },
              "required": [
                "publication_count",
                "identity_count",
                "protected_sha256",
                "governing_sha256",
                "draft_sha256",
                "publications",
                "identities"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "publication_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "identity_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "protected_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "governing_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "draft_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "publications": {
                  "type": "array"
                },
                "identities": {
                  "type": "array"
                }
              },
              "required": [
                "publication_count",
                "identity_count",
                "protected_sha256",
                "governing_sha256",
                "draft_sha256",
                "publications",
                "identities"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "size_bytes"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "observer_id",
        "method",
        "independence_limit",
        "before",
        "after",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {},
          "observed": {},
          "passed": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "expected",
          "observed",
          "passed"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "usage": {
      "type": "object",
      "properties": {
        "action_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "restarts": {
          "type": "integer",
          "minimum": 0
        },
        "retries_per_intent": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "action_attempts",
        "restarts",
        "retries_per_intent",
        "elapsed_seconds"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "enum": [
        "SUPPORTED_WITHIN_FIXTURE",
        "CONTRADICTED",
        "UNRESOLVED",
        "NOT_RUN"
      ]
    },
    "outcome_reason": {
      "type": "string",
      "minLength": 1
    },
    "claim_scope": {
      "const": "ONLY_RECORDED_CASE_AND_DECLARED_ENVELOPE"
    },
    "production_enforcement": {
      "const": "NOT_EVALUATED"
    },
    "kernel_properties": {
      "type": "object",
      "properties": {
        "non_bypassability": {
          "const": "REQUIREMENT_UNESTABLISHED"
        },
        "tamper_resistance": {
          "const": "REQUIREMENT_UNESTABLISHED"
        },
        "isolation": {
          "const": "REQUIREMENT_UNESTABLISHED"
        },
        "atomic_authorization_to_commit": {
          "const": "REQUIREMENT_UNESTABLISHED"
        }
      },
      "required": [
        "non_bypassability",
        "tamper_resistance",
        "isolation",
        "atomic_authorization_to_commit"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "UNSIGNED",
            "SIGNED"
          ]
        },
        "algorithm": {
          "type": [
            "string",
            "null"
          ]
        },
        "signer": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "trust_assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "limitation": {
          "const": "Integrity and attribution do not establish complete mediation or factual truth."
        }
      },
      "required": [
        "status",
        "algorithm",
        "signer",
        "value",
        "trust_assumptions",
        "limitation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "receipt_kind",
    "receipt_id",
    "run_id",
    "fixture_id",
    "case_id",
    "specimen_id",
    "mode",
    "binding",
    "initial_conditions",
    "schedule",
    "authoritative_ordering",
    "decision",
    "independent_effect_observations",
    "assertions",
    "usage",
    "outcome",
    "outcome_reason",
    "claim_scope",
    "production_enforcement",
    "kernel_properties",
    "signature"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "SUPPORTED_WITHIN_FIXTURE"
          }
        }
      },
      "then": {
        "properties": {
          "assertions": {
            "minItems": 1,
            "items": {
              "properties": {
                "passed": {
                  "const": true
                }
              }
            }
          },
          "authoritative_ordering": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "independent_effect_observations": {
            "properties": {
              "artifacts": {
                "minItems": 1
              },
              "before": {
                "type": "object"
              },
              "after": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "signature": {
            "properties": {
              "status": {
                "const": "UNSIGNED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "signature": {
            "properties": {
              "algorithm": {
                "type": "null"
              },
              "signer": {
                "type": "null"
              },
              "value": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "SUPPORTED_WITHIN_FIXTURE",
              "CONTRADICTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "binding": {
            "properties": {
              "contract_commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "implementation_commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "signature": {
            "properties": {
              "status": {
                "const": "SIGNED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "signature": {
            "properties": {
              "algorithm": {
                "type": "string",
                "minLength": 1
              },
              "signer": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
