{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digisleuth Governed Obsidian Write Envelope",
  "type": "object",
  "required": ["operation", "helm", "artifact_id", "object_class", "git"],
  "properties": {
    "operation": {"enum": ["CREATE_GOVERNED_NOTE", "APPEND_PROVENANCE_EVENT", "APPEND_TO_AUTHORIZED_HEADING", "PATCH_GOVERNED_FRONTMATTER"]},
    "helm": {"type": "string"},
    "artifact_id": {"type": "string", "minLength": 1},
    "object_class": {"type": "string", "minLength": 1},
    "git": {
      "type": "object",
      "required": ["path", "commit_sha", "content_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": false
    },
    "standing": {"type": "string"},
    "content": {"type": "string"},
    "heading": {"type": "string"},
    "frontmatter_patch": {"type": "object"}
  },
  "additionalProperties": false
}
